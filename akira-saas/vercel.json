{
  "buildCommand": "echo 'TOPBAR_DEPLOYMENT_TIMESTAMP=2026-08-08T$(date +%s)Z' > .env.build && rm -rf .next .vercel dist build node_modules/.vite node_modules/.cache && npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "vite",
  "outputDirectory": "dist",
  "crons": [],
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- akira-saas/ || exit 0",
  "env": {
    "FORCE_BUILD": "1",
    "VERCEL_DISABLE_PREBUILT_CACHE": "1",
    "NODE_ENV": "production"
  },
  "regions": ["sfo1"],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, private"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
