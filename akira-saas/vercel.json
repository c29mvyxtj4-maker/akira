{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/|manifest.webmanifest|sw.js|icons/|favicon.ico|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}