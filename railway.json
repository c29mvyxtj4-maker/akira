{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "cd akira-saas && npm install --legacy-peer-deps && npm run build"
  },
  "deploy": {
    "startCommand": "node index.js",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5
  }
}
