{
  "buildCommand": "cd akira-saas && npm install --legacy-peer-deps && npm run build",
  "installCommand": "cd akira-saas && npm install --legacy-peer-deps",
  "nodeVersion": "20.x",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["sfo1"]
}
