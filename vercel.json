{
  "buildCommand": "cd akira-saas && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "akira-saas/dist",
  "nodeVersion": "20.x",
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)\\.(js|css|svg|png|jpg|jpeg|gif|ico|webp|woff|woff2|eot|ttf)$",
      "dest": "/$1.$2"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.+)$",
      "dest": "/api/__catchall"
    }
  ]
}
