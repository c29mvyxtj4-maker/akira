{
  "buildCommand": "cd akira-saas && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "akira-saas/dist",
  "rewrites": [
    {
      "source": "/(.*\\.js$|.*\\.css$|.*\\.svg$|.*\\.png$|.*\\.jpg$|.*\\.gif$|.*\\.ico$|.*\\.json$|.*\\.txt$|assets/.*|icons/.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
